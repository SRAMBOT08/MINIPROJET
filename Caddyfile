{
    admin off
    auto_https off
}

:{$PORT:10000} {
    # Backend API endpoints
    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    # Agora Custom LLM callback routes
    handle /v1/* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    # API documentation
    handle /docs* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /openapi.json {
        reverse_proxy 127.0.0.1:8000
    }

    handle /redoc* {
        reverse_proxy 127.0.0.1:8000
    }

    # Frontend routes (Next.js)
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
